# Diese Werte gehoeren in die secrets.yaml deines ESPHome (ESPHome -> oben rechts "Secrets").
# Meist stehen wifi_ssid und wifi_password dort schon.

wifi_ssid:      "DEIN_WLAN"
wifi_password:  "DEIN_WLAN_PASSWORT"

# Passwort fuer Updates per WLAN (frei waehlbar).
ota_pw:         "EIN_PASSWORT"

# Passwort des Notfall-Hotspots, den die Remote aufmacht, wenn sie kein WLAN findet.
ap_password:    "NOTFALL_PASSWORT"

# Schluessel fuer den Konfigurator: zeigt dir Home Assistant beim Hinzufuegen der Integration
# "ESPHomeRemote" an (README, Schritt 2) - einfach hier einfuegen.
esphomeremote_konfig_key: "IRGENDEIN_LANGER_ZUFALLSTEXT"

# Den API-Schluessel brauchst du NICHT mehr: Home Assistant vergibt ihn beim Einbinden selbst.
