# Diese Datei nach  secrets.yaml  kopieren und ausfuellen.
# secrets.yaml selbst steht in .gitignore und gehoert NICHT ins Repository.

wifi_ssid:      "DEIN_WLAN"
wifi_password:  "DEIN_WLAN_PASSWORT"

# Base64-Schluessel fuer die verschluesselte API-Verbindung zu Home Assistant.
# Einen neuen erzeugen: https://esphome.io/components/api  ("Generate key" in der
# ESPHome-Oberflaeche) oder  `openssl rand -base64 32`.
api_key:        "BASE64_SCHLUESSEL_32_BYTE"

# Passwort fuers OTA-Update (frei waehlbar, merken).
ota_pw:         "OTA_PASSWORT"

# Passwort des Fallback-Hotspots, den das Geraet aufmacht, wenn kein WLAN geht.
ap_password:    "FALLBACK_HOTSPOT_PASSWORT"

# Gemeinsamer Schluessel fuer den direkten Funkweg Fernbedienung -> Dockingstation (ESP-NOW, ohne Home Assistant).
# Auf Remote und Docks gleich. Erzeugen z. B. mit  openssl rand -hex 16
direkt_schluessel: "32_HEX_ZEICHEN"

# Nur fuer die Dockingstation (dock/): Passwort ihres Fallback-Hotspots.
wifi_fallback:  "DOCK_HOTSPOT_PASSWORT"

# Vom Konfigurator (Integration ESPHomeRemote -> Konfigurieren zeigt ihn) - die Remote holt damit ihre Belegung.
esphomeremote_konfig_key: "SCHLUESSEL_AUS_DER_INTEGRATION"

# Entwickler-Fassung (templates/, tools/remotes.py): feste IP je Remote, Name wie in tools/remotes.json
ip_remote_wz_wohnzimmer: "192.168.1.50"
