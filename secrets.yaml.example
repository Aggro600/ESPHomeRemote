# Diese Datei nach  secrets.yaml  kopieren und ausfuellen.
# secrets.yaml selbst steht in .gitignore und gehoert NICHT ins Repository.

wifi_ssid:      "DEIN_WLAN"
wifi_password:  "DEIN_WLAN_PASSWORT"

# Base64-Schluessel fuer die verschluesselte API-Verbindung zu Home Assistant.
# Einen neuen erzeugen: https://esphome.io/components/api  ("Generate key" in der
# ESPHome-Oberflaeche) oder  `openssl rand -base64 32`.
api_key:        "BASE64_SCHLUESSEL_32_BYTE"

# Passwort fuers OTA-Update (frei waehlbar, merken).
ota_pw:         "OTA_PASSWORT"

# Passwort des Fallback-Hotspots, den das Geraet aufmacht, wenn kein WLAN geht.
ap_password:    "FALLBACK_HOTSPOT_PASSWORT"
